MIMO_API_KEY=tp-xxx
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
ASR_LANGUAGE=zh

DOUYIN_AUTH_SOURCE=auto
DOUYIN_CHROME_PROFILE=Default

TEMP_DIR=/tmp/yk-douyin-asr
DATA_DIR=~/.yk-douyin-asr

DOUYIN_LOGIN_TIMEOUT_SEC=120
DOUYIN_LOGIN_HEADFUL_FALLBACK=true

HOST=127.0.0.1
# 开发：3900 = Web UI (Vite)，3902 = API (Hono)
WEB_PORT=3900
API_PORT=3902
# 生产：单端口
PORT=3900
